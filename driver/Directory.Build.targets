<!-- The SDK NuGet package's targets, for -p:PattieWdkNuGet=true (see Directory.Build.props). -->
<Project>
  <ImportGroup Condition="'$(PattieWdkNuGet)' == 'true'">
    <Import Project="$(PattieNuGetDir)Microsoft.Windows.SDK.CPP.$(PattieKitVersion)\build\native\Microsoft.Windows.SDK.cpp.targets" />
  </ImportGroup>
</Project>
