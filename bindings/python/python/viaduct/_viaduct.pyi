"""Types for the native module. The code is in ``bindings/python/src/lib.rs``."""

from collections.abc import Buffer, Iterator
from types import TracebackType
from typing import ClassVar, Literal, Self, final

type Encoding = Literal["f32", "pcm16", "ulaw"]

class Error(Exception): ...
class DriverNotInstalled(Error): ...
class AudioServerUnavailable(Error): ...
class AccessDenied(Error): ...
class NoBackend(Error): ...
class VersionMismatch(Error): ...
class UnsupportedFormat(Error): ...
class BadBufferSize(Error): ...
class BadName(Error): ...
class DuplicateName(Error): ...
class TooManyDevices(Error): ...
class WrongKind(Error): ...
class AlreadyTaken(Error): ...
class SystemRefused(Error): ...
class ProtocolError(Error): ...
class OsError(Error): ...
class AudioLost(Error): ...

@final
class Format:
    """A stream's sample rate, encoding and channel count."""

    DEVICE: ClassVar[Format]
    def __new__(cls, rate: int, encoding: Encoding = "f32", channels: int = 1) -> Self: ...
    @property
    def rate(self) -> int: ...
    @property
    def encoding(self) -> Encoding: ...
    @property
    def channels(self) -> int: ...
    @property
    def frame_bytes(self) -> int: ...

@final
class Stats:
    """Audio a Device lost so far, and how much is waiting now, in frames at the
    Device's rate."""

    @property
    def gap_frames(self) -> int: ...
    @property
    def overflow_frames(self) -> int: ...
    @property
    def buffered_frames(self) -> int: ...

@final
class Interrupted:
    """What ``Playout.interrupt()`` cut."""

    @property
    def heard_frames(self) -> int: ...
    @property
    def discarded_frames(self) -> int: ...
    @property
    def heard_ms(self) -> int: ...

@final
class Clock:
    """Where the system's side of a Device had got to: ``frames`` (at its rate) at
    ``at``, a ``time.perf_counter()`` time."""

    @property
    def frames(self) -> int: ...
    @property
    def at(self) -> float: ...

@final
class LiveStats:
    """How a ``LiveWriter`` is doing."""

    @property
    def queued_frames(self) -> int: ...
    @property
    def correction_ppm(self) -> float: ...
    @property
    def starved_frames(self) -> int: ...
    @property
    def dropped_frames(self) -> int: ...

@final
class LiveWriter:
    """A live source's input, drift-compensated: see ``Microphone.live_writer()``."""

    def push(self, data: Buffer) -> int: ...
    @property
    def stats(self) -> LiveStats: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        kind: type[BaseException] | None,
        value: BaseException | None,
        traceback: TracebackType | None,
    ) -> bool: ...

@final
class Playout:
    """A voice agent's output: see ``Microphone.playout()``."""

    def push(self, data: Buffer) -> int: ...
    def interrupt(self) -> Interrupted: ...
    def wait_idle(self, timeout: float | None = None) -> bool: ...
    @property
    def queued_frames(self) -> int: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        kind: type[BaseException] | None,
        value: BaseException | None,
        traceback: TracebackType | None,
    ) -> bool: ...

@final
class Microphone:
    """A virtual microphone: audio the app writes is what other apps record."""

    def __new__(
        cls,
        name: str,
        *,
        rate: int = 48_000,
        channels: int = 1,
        format: Format | None = None,  # noqa: A002
        strict: bool = False,
        _backend: object = None,
    ) -> Self: ...
    @property
    def id(self) -> int: ...
    @property
    def format(self) -> Format: ...
    @property
    def rate(self) -> int: ...
    @property
    def channels(self) -> int: ...
    @property
    def closed(self) -> bool: ...
    def write(self, data: Buffer, timeout: float | None = None) -> int: ...
    def write_nowait(self, data: Buffer) -> int: ...
    def wait_for_playout(self, timeout: float | None = None) -> bool: ...
    @property
    def played_frames(self) -> int: ...
    @property
    def played_ms(self) -> int: ...
    @property
    def stats(self) -> Stats: ...
    def playout(self, format: Format | None = None) -> Playout: ...  # noqa: A002
    def live_writer(self, format: Format | None = None) -> LiveWriter: ...  # noqa: A002
    @property
    def clock(self) -> Clock | None: ...
    @property
    def next_play_time(self) -> float | None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        kind: type[BaseException] | None,
        value: BaseException | None,
        traceback: TracebackType | None,
    ) -> bool: ...

@final
class Speaker:
    """A virtual speaker: audio other apps play to it is what the app reads."""

    def __new__(
        cls,
        name: str,
        *,
        rate: int = 48_000,
        channels: int = 1,
        format: Format | None = None,  # noqa: A002
        _backend: object = None,
    ) -> Self: ...
    @property
    def id(self) -> int: ...
    @property
    def rate(self) -> int: ...
    @property
    def channels(self) -> int: ...
    @property
    def closed(self) -> bool: ...
    def read(self, timeout: float | None = 0.0) -> bytes: ...
    def read_timed(self, timeout: float | None = 0.0) -> tuple[bytes, float | None]: ...
    @property
    def clock(self) -> Clock | None: ...
    def __iter__(self) -> Iterator[bytes]: ...
    def __next__(self) -> bytes: ...
    @property
    def stats(self) -> Stats: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        kind: type[BaseException] | None,
        value: BaseException | None,
        traceback: TracebackType | None,
    ) -> bool: ...

@final
class Converter:
    """Converts audio between two Formats, keeping its state between calls."""

    def __new__(cls, source: Format, target: Format) -> Self: ...
    def convert(self, data: Buffer) -> bytes: ...

def stable_id(
    kind: Literal["microphone", "speaker"], name: str, rate: int = 48_000, channels: int = 1
) -> str: ...

# Only in the project's own test builds (see viaduct._testing).
@final
class TestBackend:
    def __new__(cls) -> Self: ...
    @property
    def lead_frames(self) -> int: ...
    def driver_read(self, device_id: int, count: int) -> bytes | None: ...
    def driver_write(self, device_id: int, data: Buffer) -> bool: ...
