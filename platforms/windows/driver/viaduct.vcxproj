<?xml version="1.0" encoding="utf-8"?>
<!--
  Viaduct Windows driver: the thin ACX/KMDF shell around the pure C core (ADR 0002).
  Builds the .sys only. Signing and deployment are off: nothing is installed,
  loaded, or added to the certificate store by building this project.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{2AF73719-1B89-4C3F-961C-1FEEB339602F}</ProjectGuid>
    <TemplateGuid>{1bc93793-694f-48fe-9372-81e2b05556fd}</TemplateGuid>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <MinimumVisualStudioVersion>12.0</MinimumVisualStudioVersion>
    <RootNamespace>viaduct</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.28000.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <!-- ACX 1.1 needs KMDF 1.31 or later (ADR 0001). -->
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>33</KMDF_VERSION_MINOR>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Release'">false</UseDebugLibraries>
    <SpectreMitigation>Spectre</SpectreMitigation>
    <!-- No test signing: building must not touch the certificate store. -->
    <SignMode>Off</SignMode>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <TargetName>viaduct</TargetName>
    <OutDir>$(MSBuildThisFileDirectory)..\..\..\target\driver\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\..\..\target\driver\obj\$(Platform)\$(Configuration)\</IntDir>
    <EnableInf2cat>false</EnableInf2cat>
    <!-- DriverVer's version: a release build passes -p:ViaductDriverVersion=a.b.c.d
         (make-attestation-cab.ps1); otherwise StampInf derives one from the build
         time. -->
    <ViaductDriverVersion Condition="'$(ViaductDriverVersion)' == ''">*</ViaductDriverVersion>
    <EnableDeployment>false</EnableDeployment>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <!-- The kernel toolset ignores LanguageStandard_C, so pass C17 directly.
           C4242/C4244 (possible loss of data) and C4365 (signed/unsigned
           mismatch) are off by default; on, and errors, for code that parses
           what apps send. -->
      <AdditionalOptions>/std:c17 /w44242 /w44244 /w44365 %(AdditionalOptions)</AdditionalOptions>
      <!-- kernel-crt first: kernel-safe stdint.h/stdbool.h shadow the user-mode MSVC ones. -->
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)kernel-crt;$(MSBuildThisFileDirectory)..\..\..\core\include;$(MSBuildThisFileDirectory)..\..\..\core\src;$(DDK_INC_PATH)acx\km\1.1;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>ACX_VERSION_MAJOR=1;ACX_VERSION_MINOR=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <!-- ksguid.lib: in C, ks.h only declares the KS category and node-type GUIDs. -->
      <AdditionalDependencies>$(DDK_LIB_PATH)acx\km\1.1\acxstub.lib;$(DDK_LIB_PATH)ksguid.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup Label="Pure core (ADR 0002), compiled unchanged">
    <ClCompile Include="..\..\..\core\src\viaduct_core.c" />
    <ClCompile Include="..\..\..\core\src\viaduct_ring.c" />
    <ClCompile Include="..\..\..\core\src\viaduct_clock.c" />
    <ClCompile Include="..\..\..\core\src\viaduct_pcm16.c" />
  </ItemGroup>

  <ItemGroup Label="Shell">
    <ClCompile Include="src\driver.c" />
    <ClCompile Include="src\control.c" />
    <ClCompile Include="src\endpoint.c" />
    <ClCompile Include="src\circuit.c" />
    <ClCompile Include="src\interfaces.c" />
    <ClCompile Include="src\stream.c" />
    <ClCompile Include="src\trace.c" />
    <ClInclude Include="src\shell.h" />
  </ItemGroup>

  <ItemGroup Label="Package">
    <Inf Include="viaduct.inf">
      <SpecifyDriverVerDirectiveVersion>true</SpecifyDriverVerDirectiveVersion>
      <TimeStamp>$(ViaductDriverVersion)</TimeStamp>
    </Inf>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
