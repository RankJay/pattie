# C style for the Core (core/) and the driver (driver/src/): what the code already does,
# written down so clang-format keeps it. CI checks it (ci.yml). The frozen ABI header is
# left as it is (.clang-format-ignore).
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 100
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
PointerAlignment: Right
SortIncludes: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: true
IndentCaseLabels: false
AlignTrailingComments:
  Kind: Leave
